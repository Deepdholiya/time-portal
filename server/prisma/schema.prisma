// SQLite for local development. For Postgres, set provider = "postgresql"
// and point DATABASE_URL at your database.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy ----------

// A company is the tenant boundary: clients, projects, tasks, time and settings all belong to one.
model Company {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  color        String    @default("#5e6ad2")
  logoUrl      String?
  country      String    @default("India")
  timezone     String    @default("Asia/Kolkata")
  currency     String    @default("INR")
  workWeek     String    @default("1,2,3,4,5") // ISO weekdays that are working days
  weekStartsOn Int       @default(1) // 1 = Monday
  hoursPerDay  Float     @default(8)
  billingNotes String?
  // JSON blob of company settings: thresholds, security, AI, temp password expiry...
  settings     String    @default("{}")
  status       String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt    DateTime  @default(now())

  memberships   Membership[]
  teams         Team[]
  clients       Client[]
  projects      Project[]
  initiatives   Initiative[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  holidays      Holiday[]
  customFields  CustomField[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  notifications Notification[]
  savedViews    SavedView[]
  reports       SavedReport[]
  templates     Template[]
  emails        EmailMessage[]
  leaves        LeaveRequest[]
  periods       TimesheetPeriod[]
  automations   Automation[]
  integrations  Integration[]
  permissions   RolePermission[]
}

model Membership {
  companyId   Int
  userId      Int
  teamId      Int?
  allProjects Boolean  @default(false)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@id([companyId, userId])
}

// ---------- People & auth ----------

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  passwordHash       String
  role               String    @default("EMPLOYEE") // ADMIN | MANAGER | EMPLOYEE
  status             String    @default("ACTIVE") // INVITED | ACTIVE | DEACTIVATED
  title              String?
  phone              String?
  location           String?
  weeklyCapacity     Float     @default(40)
  costRate           Float? // internal hourly cost, Admin only
  billRate           Float? // default hourly bill rate
  mustChangePassword Boolean   @default(false)
  tempPasswordExpiresAt DateTime?
  mfaSecret          String?
  mfaEnabled         Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastCompanyId      Int?
  emailVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())

  memberships   Membership[]
  sessions      Session[]
  managed       Project[]          @relation("ProjectManager")
  projectRoles  ProjectMember[]
  timeEntries   TimeEntry[]
  assigned      Task[]             @relation("Assignee")
  created       Task[]             @relation("Creator")
  comments      Comment[]
  attachments   Attachment[]
  following     TaskFollower[]
  periods       TimesheetPeriod[]  @relation("PeriodOwner")
  reviewed      TimesheetPeriod[]  @relation("PeriodReviewer")
  leaves        LeaveRequest[]     @relation("LeaveOwner")
  leaveReviews  LeaveRequest[]     @relation("LeaveReviewer")
  notifications Notification[]
  auditLogs     AuditLog[]
  invitesSent   Invitation[]       @relation("InvitedBy")
  savedViews    SavedView[]
  reports       SavedReport[]
  emails        EmailMessage[]
  resets        PasswordReset[]
  permissions   UserPermission[]
}

model Session {
  id         String    @id
  userId     Int
  companyId  Int?
  ip         String?
  userAgent  String?
  mfaPassed  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id             Int       @id @default(autoincrement())
  companyId      Int
  userId         Int? // the INVITED user account created for this invitation
  email          String
  name           String
  role           String    @default("EMPLOYEE")
  title          String?
  teamId         Int?
  weeklyCapacity Float     @default(40)
  allProjects    Boolean   @default(false)
  projectIds     String    @default("[]") // JSON array
  status         String    @default("PENDING") // PENDING | ACCEPTED | REVOKED (EXPIRED is computed)
  expiresAt      DateTime
  acceptedAt     DateTime?
  sentCount      Int       @default(1)
  invitedById    Int?
  createdAt      DateTime  @default(now())
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy      User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
}

model Team {
  id        Int          @id @default(autoincrement())
  companyId Int
  name      String
  color     String       @default("#5e6ad2")
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members   Membership[]
  projects  Project[]
}

// Role-level permission overrides, per company.
model RolePermission {
  companyId Int
  role      String
  feature   String
  level     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, role, feature])
}

// Per-person overrides on top of their role.
model UserPermission {
  companyId Int
  userId    Int
  feature   String
  level     String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId, feature])
}

// ---------- Work structure ----------

model Client {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  email       String?
  contactName String?
  phone       String?
  website     String?
  rate        Float? // default hourly rate
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects    Project[]
}

model Initiative {
  id        Int       @id @default(autoincrement())
  companyId Int
  name      String
  color     String    @default("#5e6ad2")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects  Project[]
}

model Project {
  id             Int       @id @default(autoincrement())
  companyId      Int
  name           String
  code           String?
  description    String?
  notes          String? // project notes (markdown)
  color          String    @default("#5e6ad2")
  status         String    @default("ACTIVE") // PLANNING | ACTIVE | ON_HOLD | COMPLETED
  priority       String    @default("MEDIUM") // URGENT | HIGH | MEDIUM | LOW | NONE
  health         String    @default("ON_TRACK") // manual override; computed health is returned alongside
  archived       Boolean   @default(false)
  startDate      String? // YYYY-MM-DD
  endDate        String?
  estimatedHours Float?
  budget         Float?
  billingType    String    @default("HOURLY") // HOURLY | FIXED | NON_BILLABLE
  hourlyRate     Float?
  tags           String    @default("[]") // JSON array
  links          String    @default("{}") // JSON {figma, document, drive, other[]}
  clientShareToken String? @unique
  clientId       Int?
  parentId       Int?
  managerId      Int?
  teamId         Int?
  initiativeId   Int?
  createdAt      DateTime  @default(now())
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parent         Project?  @relation("SubProjects", fields: [parentId], references: [id], onDelete: Cascade)
  children       Project[] @relation("SubProjects")
  manager        User?     @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  initiative     Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  milestones     Milestone[]
  tasks          Task[]
  timeEntries    TimeEntry[]
}

model ProjectMember {
  projectId Int
  userId    Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Milestone {
  id          Int      @id @default(autoincrement())
  projectId   Int
  name        String
  description String?
  date        String // YYYY-MM-DD
  done        Boolean  @default(false)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id             Int       @id @default(autoincrement())
  companyId      Int
  number         Int // per-company sequence, shown as KEY-123
  title          String
  description    String?
  status         String    @default("TODO") // BACKLOG | TODO | IN_PROGRESS | IN_REVIEW | BLOCKED | DONE
  priority       String    @default("NONE") // URGENT | HIGH | MEDIUM | LOW | NONE
  section        String?
  sortOrder      Float     @default(0)
  startDate      String?
  dueDate        String?
  estimateHours  Float?
  billable       Boolean   @default(true)
  tags           String    @default("[]")
  customFields   String    @default("{}")
  recurrence     String? // DAILY | WEEKLY | MONTHLY | null
  completedAt    DateTime?
  projectId      Int
  parentId       Int?
  milestoneId    Int?
  assigneeId     Int?
  creatorId      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]    @relation("Subtasks")
  milestone      Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee       User?     @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User?     @relation("Creator", fields: [creatorId], references: [id], onDelete: SetNull)
  blocking       TaskDependency[] @relation("Blocker")
  blockedBy      TaskDependency[] @relation("Blocked")
  comments       Comment[]
  attachments    Attachment[]
  followers      TaskFollower[]
  activity       TaskActivity[]
  timeEntries    TimeEntry[]

  @@unique([companyId, number])
  @@index([projectId])
  @@index([assigneeId])
}

model TaskDependency {
  blockerId Int // must finish first
  blockedId Int
  blocker   Task @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Task @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model TaskFollower {
  taskId Int
  userId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  body      String
  mentions  String   @default("[]")
  createdAt DateTime @default(now())
  editedAt  DateTime?
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  name      String
  mime      String
  size      Int
  storedAs  String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int
  actorId   Int?
  action    String // created | field | comment | attachment | dependency | time
  field     String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model CustomField {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String
  type      String  @default("TEXT") // TEXT | NUMBER | SELECT | DATE
  options   String  @default("[]")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Project and task templates. Payload is JSON describing sections, tasks, subtasks, milestones, dependencies.
model Template {
  id        Int      @id @default(autoincrement())
  companyId Int
  kind      String // PROJECT | TASK
  name      String
  payload   String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Time ----------

model TimeEntry {
  id             Int       @id @default(autoincrement())
  companyId      Int
  date           String // YYYY-MM-DD
  startTime      String? // HH:MM
  endTime        String?
  minutes        Int
  description    String
  billable       Boolean   @default(true)
  running        Boolean   @default(false)
  startedAt      DateTime? // when the current running segment started
  pausedAt       DateTime?
  accumulatedSec Int       @default(0) // seconds from earlier segments of a paused timer
  userId         Int
  projectId      Int
  taskId         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([companyId, date])
  @@index([userId, date])
  @@index([projectId])
}

model TimesheetPeriod {
  id           Int       @id @default(autoincrement())
  companyId    Int
  weekStart    String
  status       String    @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED
  note         String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  userId       Int
  reviewedById Int?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation("PeriodOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("PeriodReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId, weekStart])
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  companyId    Int
  userId       Int
  type         String    @default("VACATION") // VACATION | SICK | PERSONAL | OTHER
  from         String
  to           String
  halfDay      Boolean   @default(false)
  reason       String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedById Int?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model Holiday {
  id        Int     @id @default(autoincrement())
  companyId Int
  date      String
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Views, reports, notifications ----------

model SavedView {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  page      String // tasks | reports | roadmap ...
  name      String
  config    String
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedReport {
  id         Int       @id @default(autoincrement())
  companyId  Int
  userId     Int
  name       String
  config     String // filters, grouping, columns, chart
  schedule   String? // DAILY | WEEKLY | MONTHLY | QUARTERLY
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int       @id @default(autoincrement())
  companyId Int?
  userId    Int
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  dedupeKey String?
  createdAt DateTime  @default(now())
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Every outgoing email lands here. With SMTP configured it is also delivered.
model EmailMessage {
  id          Int       @id @default(autoincrement())
  companyId   Int?
  kind        String // INVITATION | PASSWORD_RESET | CLIENT_UPDATE | REPORT
  to          String
  subject     String
  body        String
  aiGenerated Boolean   @default(false)
  status      String    @default("SENT") // DRAFT | SENT
  sentById    Int?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sentBy      User?     @relation(fields: [sentById], references: [id], onDelete: SetNull)
}

model Automation {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  trigger   String // TASK_STATUS | TASK_OVERDUE | TIMESHEET_REMINDER | DUE_SOON
  config    String   @default("{}")
  enabled   Boolean  @default(true)
  runs      Int      @default(0)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Integration {
  id        Int      @id @default(autoincrement())
  companyId Int
  kind      String // GOOGLE_SSO | MICROSOFT_SSO | SLACK | GOOGLE_CALENDAR | SMTP
  config    String   @default("{}")
  enabled   Boolean  @default(false)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  companyId Int?
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  oldValue  String?
  newValue  String?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}
